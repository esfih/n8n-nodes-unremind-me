{
  "name": "n8n-nodes-unremind-me",
  "version": "0.1.5",
  "description": "n8n community node for UnRemind.me — context-aware reminders that surface when your situation matches, not at a fixed time",
  "keywords": [
    "n8n-community-node-package",
    "unremind",
    "reminders",
    "tasks",
    "mcp",
    "ai-agents"
  ],
  "license": "MIT",
  "homepage": "https://unremind.me",
  "author": {
    "name": "UnRemind.me",
    "email": "support@unremind.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esfih/n8n-nodes-unremind-me.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-icons.js",
    "dev": "tsc --watch",
    "lint": "node scripts/lint.mjs"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/UnRemindMeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/UnRemindMe/UnRemindMe.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/eslint-plugin-community-nodes": "^0.30.0",
    "@n8n/scan-community-package": "^0.33.0",
    "eslint": "^9.29.0",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
